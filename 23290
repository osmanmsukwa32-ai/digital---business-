* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  
}

body {
  font-family: Arial, sans-serif;
  line-height: 1.6;
  background: #f5f5f5;
  color: #222;
}

.navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px;
  background: #111;
  color: white;
}

.nav-links a {
  color: white;
  text-decoration: none;
  margin-left: 15px;
}

.hero {
  min-height: 80vh;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  position: 40px 20px;
  background: #222;
  color: white;
}

.hero h1 {
  font-size: 48px;
  margin: 15px 0;
  
}

.hero p {
  max-width: 600px;
  margin: 0 auto 25px;
}

.small-title {
  letter-spacing: 3px;
}

.button {
  display: inline-block;
  padding: 12px 25px;
  background: white;
  color: #111;
  text-decoration: none;
  border-radius: 6px;
}

section {
  padding: 70px 20px;
  text-align: center;
}

section h2 {
  margin-bottom: 30px;
  font-size: 32px;
}

.cards {
  display: flex;
  justify-content: center;
  gap: 20px;
  flex-wrap: wrap;
  
}

.card, 
.project{
  background: white;
  padding: 25px;
  width: 300px;
  border-radius: 10px;
  box-shadow: 0 4px 15px
  rgba(0,0,0,0.08);
  
}

.card h3,
.project h3 {
  margin-bottom: 15px;
  
}

#about {
  background: white;
}

#about p {
  max-width: 650px;
  margin: auto;
}

button {
  padding: 13px 25px;
  border: none;
  border-radius: 6px;
  cursor: pointer;
  font-size: 15px;
  
  
}

footer {
  text-align: center;
  padding: 25px;
  background: #111;
  color: white;
}

@media (max-width:700px){

  .navbar {
    flex-direction: column;
    gap: 15px;
  }

  .nav-links {
    text-align: center;
  }

  .nav-links a {
    display: inline-block;
    margin: 5px;
  }

  .hero h1 {
    font-size: 36px;
  }

  .whatsapp {
    display: inline-block;
    margin: 20px 0px;
    padding: 13px 25px;
    background: #25D366;
    color: white;
    text-decoration: none;
    border-radius: 6px;
  }

  form {
    max-width: 500px;
    margin: 25px auto;
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  input,
  textarea {
    padding: 14px;
    border: 1px solid #ccc;
    border-radius: 6px;
    font-size: 16px;
  }

  textarea {
    min-height: 150px;
    resize: vertical;
  }

  .menu-btn {
    display: none;
    background: none;
    color: white;
    font-size: 28px;
  }

  @media(max-width: 700px){
    .menu-btn{
      direction: block;
    }

    .nav-links {
      display: none;
      width: 100%;
      text-align: center;
    }

    .nav-links.show {
      display: block;
    }

    nav-links a {
      direction: block;
      padding: 10px;
    }

    .card,
    .project {
      transition: transform 0.3s
      ease;
    }

    .card:hover,
    .project:hover {
      transform: translateY(-8px);
    }

    .button,
    button {
      transition: transform 0.2s
    ease;
    }

    .button:hover,
    button:hover {
      transform: scale(1.05);
    }
  

  

