<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport"
      content="width=device-width,
      initial-scale=1.0">
    <title>Imhotep Digital</title>

    <link rel="stylesheet" href="style.css"
  </head>
  <body>

    <header>
      <nav class="navbar">
        <h2>Imhotep Digital</h2>
        <button class="menu-btn"
          onclick="toggleMenu()">
          
        </button>

        <div class="nav-links"
          id="navLinks">
          <a href="#home">Home</a>
          <a href="#services">Services</a>
          <a href="#portfolio">Portfolio</a>
          <a href="#about">About</a>
          <a href="#contact">Contact</a>
        </div>
      </nav>
    </header>

    <main>

      <!--HOME-->

      <section id="home" class="hero">
        <div>
          <p class="small-title">
            DIGITAL SERVICES
            
          </p>
      
    <h1>Build your Business On line</h1>

    <p>I create modern websites and
      digital solutions for busineses, organisations 
    and individuals.</p>

          <a href="#contact" class="button">
            Get started
          </a>
    
        </div>
      </section>

      <!--SERVICES-->
      <section id="services">
        <h2>My Services</h2>

        <div class="cards">

          <div class="card">
            <h3>websites Design</h3>

            <p>Modern and responsive websites
            for busineses and organisations.
            </p>
          
        </div>

          <div class="card">
            <h3>Graphic Design</h3>

            <p>Posters, Logos, banners and
            social media graphics</p>
            
          </div>

          <div class="card">
            <h3>Social Media</h3>
            <p>social media content and
            digital marketing support.</p>
          </div>
          
        </div>
      </section>

      <!--PORTFOLIO-->
      <section id="portfolio">
        <h2>My Portfolio</h2>

        <div class="cards">

          <div class="project">
            <h3>Business website</h3>

            <p>Profession website for
            a professional.</p>

            <div class="project">
              <h3>Organisation websites</h3>
              <p>Information website for an 
                organisation.</p>
          </div>
          
        </div>
      </section>

      <!--ABOUT-->

      <section id="about">
        <h2>About Me</h2>
        <p>I am learning web development
        and digital technology.
        My goal is to help people
        and busineses build strong presence
        online.</p>
        
      </section>

      <!--CONTACT-->
      <section id="contact">
        <h2>Let's Work Together</h2>

        <p>Need a website or digital service?
        Contact me today.</p>

        <button onclick="contactMessage()">
          Contact Me
          
        </button>

        <a class="whatsapp" href="https://
          wa.me/265894030557"
          target="_blank">...
        chat on WhatsApp</a>

        <form id="contactForm">

          <input type="text"
            id="name"
            placeholder="your name"required>

          <input
            type="email"
            id="email"
            placeholder="your email"
            required>

          <textarea
            id="message"
            placeholder="your email"
            required>
            
          </textarea>

          
        </form>
        
      </section>

    </main>

    <footer>
      <p>© 2026 Imhotep Digital. All Rights
      Reserved.</p>
    </footer>

    <script src="script.js"></script>
  </body>
  </html>